<?xml version="1.0" encoding="UTF-8"?>
<!--
    Formato vacío de un reporte JUnit de la suite de interfaz (Selenium).

    run-interfaz.ps1 llena este formato con --log-junit y lo guarda en
    ../resultados/junit-<suite>.xml.
-->
<testsuites>
    <testsuite name="{{SUITE}}" tests="0" assertions="0" errors="0" failures="0" skipped="0" time="0.000">
        <!--
            Una entrada por escenario ejecutado:

            <testcase name="{{ESCENARIO}}" class="{{CLASE}}" classname="{{CLASE_CON_PUNTOS}}"
                      file="{{ARCHIVO}}" line="0" assertions="0" time="0.000">
                <failure type="...">...</failure>   opcional
                <skipped/>                           opcional
            </testcase>
        -->
    </testsuite>
</testsuites>
