<?xml version="1.0" encoding="UTF-8"?>
<!--
    Formato vacío de un reporte JUnit de las pruebas ALFA.

    Lo produce run-alfa.php: un testcase por comprobación HTTP funcional de cada
    grupo (auth, catalogo, inventario, comercial, compras, operaciones,
    reportes, sistema). Se guarda en ../resultados/.
-->
<testsuites>
    <testsuite name="{{SUITE}}" tests="0" assertions="0" errors="0" failures="0" skipped="0" time="0.000">
        <!--
            Una entrada por comprobación:

            <testcase name="{{PRUEBA}}" class="{{CLASE}}" classname="{{CLASE}}"
                      assertions="0" time="0.000">
                <failure type="...">...</failure>   opcional
                <skipped/>                           opcional
            </testcase>
        -->
    </testsuite>
</testsuites>
