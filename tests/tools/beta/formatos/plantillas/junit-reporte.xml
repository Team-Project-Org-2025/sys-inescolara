<?xml version="1.0" encoding="UTF-8"?>
<!--
    Formato vacío de un reporte JUnit de las pruebas ALFA/BETA.

    Los ejecutores run-alfa.php y run-beta.php llenan este formato. Se guarda
    una copia por prueba en ../resultados/ (por ejemplo junit-humo.xml).
-->
<testsuites>
    <testsuite name="{{SUITE}}" tests="0" assertions="0" errors="0" failures="0" skipped="0" time="0.000">
        <!--
            Una entrada por prueba ejecutada:

            <testcase name="{{PRUEBA}}" class="{{CLASE}}" classname="{{CLASE}}"
                      assertions="0" time="0.000">
                <failure type="...">...</failure>   opcional
                <skipped/>                           opcional
            </testcase>
        -->
    </testsuite>
</testsuites>
