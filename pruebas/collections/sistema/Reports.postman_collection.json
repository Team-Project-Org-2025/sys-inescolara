{
  "info": {
    "_postman_id": "c0a00000-0010-4000-8000-000000000010",
    "name": "SYSINECOLARA · Reportes",
    "description": "Módulos, filtros, datos y PDF de reportes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'X-Requested-With', value: 'XMLHttpRequest' });",
          "const d = new Date(); pm.collectionVariables.set('today', d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "today",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 · Auth",
      "item": [
        {
          "name": "401 · sin sesion (redirect)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.cookies.clear();",
                  "pm.request.headers.remove('Cookie');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde (redirect o login)', () => pm.expect([200,301,302,401]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports?action=get_modules",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports"
              ],
              "query": [
                {
                  "key": "action",
                  "value": "get_modules"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST /login (admin)",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login admin', () => {",
                  "  pm.expect([200,302]).to.include(pm.response.code);",
                  "  pm.expect(pm.cookies.get('PHPSESSID')).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "nombre_usuario",
                  "value": "{{usuario}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                },
                {
                  "key": "g-recaptcha-response",
                  "value": "{{recaptchaToken}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
