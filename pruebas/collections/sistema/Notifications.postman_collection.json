{
  "info": {
    "_postman_id": "c0a00000-0011-4000-8000-000000000011",
    "name": "SYSINECOLARA · Notificaciones",
    "description": "Notificaciones por segmento (/notifications/<accion>).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'X-Requested-With', value: 'XMLHttpRequest' });",
          "const d = new Date(); pm.collectionVariables.set('today', d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "today",
      "value": ""
    },
    {
      "key": "nid",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 · Auth",
      "item": [
        {
          "name": "POST /login (admin)",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login admin', () => {",
                  "  pm.expect([200,302]).to.include(pm.response.code);",
                  "  pm.expect(pm.cookies.get('PHPSESSID')).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "nombre_usuario",
                  "value": "{{usuario}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                },
                {
                  "key": "g-recaptcha-response",
                  "value": "{{recaptchaToken}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
