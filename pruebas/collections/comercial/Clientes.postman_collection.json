    {
      "name": "01 · Listado",
      "item": [
        {
          "name": "GET get_clients",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('clientes es arreglo', () => pm.expect(body.clientes).to.be.an('array'));",
                  "pm.test('cada cliente trae id y nombre', () => body.clientes.forEach((c) => { pm.expect(c).to.have.property('id'); pm.expect(c).to.have.property('nombre_cliente'); }));",
                  "pm.test('count se mantiene en 0 (deuda conocida)', () => pm.expect(body.count).to.eql(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/clientes?action=get_clients",
