          "name": "GET get_prices",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('success = true', () => pm.expect(body.success).to.eql(true));",
                  "pm.test('prices es arreglo', () => pm.expect(body.prices).to.be.an('array'));",
                  "pm.test('count coincide', () => pm.expect(body.count).to.eql(body.prices.length));",
                  "pm.test('cada precio trae precio_final y valor_total_inventario', () => body.prices.forEach((p) => { pm.expect(p).to.have.property('precio_final'); pm.expect(p).to.have.property('valor_total_inventario'); }));"
                ]
              }
            }
