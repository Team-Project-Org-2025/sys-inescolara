          "name": "POST actualizar_precio_ajax (subir costo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('success = true', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.sendRequest({",
                  "  url: pm.environment.get('baseUrl') + '/precios?action=get_prices',",
                  "  header: { 'X-Requested-With': 'XMLHttpRequest' }",
                  "}, (err, res) => {",
                  "  pm.test('El precio final se recalcula', () => {",
                  "    pm.expect(err).to.be.null;",
                  "    const row = res.json().prices.find((p) => p.id_lote === 1);",
                  "    pm.expect(row, 'lote 1').to.exist;",
                  "    pm.expect(Number(row.precio_final)).to.eql(7.8);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
