    {
      "name": "01 · Listado",
      "item": [
        {
          "name": "GET get_batches",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('success = true', () => pm.expect(body.success).to.eql(true));",
                  "pm.test('lotes es arreglo', () => pm.expect(body.lotes).to.be.an('array'));",
                  "pm.test('count coincide', () => pm.expect(body.count).to.eql(body.lotes.length));",
                  "pm.test('cada lote trae id y cantidad_actual', () => body.lotes.forEach((l) => { pm.expect(l).to.have.property('id'); pm.expect(l).to.have.property('cantidad_actual'); }));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/lotes?action=get_batches",
              "host": [
                "{{baseUrl}}"
