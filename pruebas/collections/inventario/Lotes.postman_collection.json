    {
      "name": "03 · Editar",
      "item": [
        {
          "name": "POST edit_ajax",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('success = true', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "const id = pm.collectionVariables.get('loteId');",
                  "pm.sendRequest({",
                  "  url: pm.environment.get('baseUrl') + '/lotes?action=get_batches',",
                  "  header: { 'X-Requested-With': 'XMLHttpRequest' }",
                  "}, (err, res) => {",
                  "  pm.test('El cambio persiste', () => {",
                  "    pm.expect(err).to.be.null;",
                  "    const item = res.json().lotes.find((x) => String(x.id) === String(id));",
                  "    pm.expect(item, 'lote ' + id).to.exist;",
                  "    pm.expect(item.cantidad_actual).to.eql(4);",
                  "    pm.expect(item.id_ubicacion).to.eql(2);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
