    {
      "name": "03 · Editar",
      "item": [
        {
          "name": "POST edit_ajax",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('success = true', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "const id = pm.collectionVariables.get('insumosId');",
                  "pm.sendRequest({",
                  "  url: pm.environment.get('baseUrl') + '/' + \"insumos\" + '?action=get_supplies',",
                  "  header: { 'X-Requested-With': 'XMLHttpRequest' }",
                  "}, (err, res) => {",
                  "  pm.test('El cambio persiste', () => {",
                  "    pm.expect(err).to.be.null;",
                  "    const item = res.json().supplies.find((x) => String(x.id) === String(id));",
                  "    pm.expect(item, 'registro ' + id).to.exist;",
                  "    pm.expect(item[\"nombre_insumo\"]).to.eql(\"Test Insumo Editado\");",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "id",
                  "value": "{{insumosId}}",
                  "type": "text"
                },
                {
                  "key": "nombre_insumo",
                  "value": "Test Insumo Editado",
                  "type": "text"
                },
                {
                  "key": "id_unidad_medida",
                  "value": "1",
