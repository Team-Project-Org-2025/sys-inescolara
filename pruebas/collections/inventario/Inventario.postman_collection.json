      "name": "00 · Auth (admin)",
      "item": [
        {
          "name": "401 · GET get_consolidated sin sesion",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.cookies.clear();",
                  "pm.request.headers.remove('Cookie');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 sin sesion', () => pm.response.to.have.status(401));",
                  "pm.test('success = false', () => pm.expect(pm.response.json().success).to.eql(false));",
                  "pm.test('Mensaje No autorizado', () => pm.expect(pm.response.json().message).to.match(/no autorizado/i));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/inventario?action=get_consolidated",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inventario"
              ],
              "query": [
                {
                  "key": "action",
                  "value": "get_consolidated"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST /login (admin)",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Sesion admin', () => {",
                  "  pm.expect([200, 302]).to.include(pm.response.code);",
                  "  pm.expect(pm.cookies.get('PHPSESSID')).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "nombre_usuario",
                  "value": "{{usuario}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                },
                {
                  "key": "g-recaptcha-response",
                  "value": "{{recaptchaToken}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "01 · Consolidado",
      "item": [
        {
          "name": "GET get_consolidated",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('success = true', () => pm.expect(body.success).to.eql(true));",
                  "pm.test('data es arreglo', () => pm.expect(body.data).to.be.an('array'));",
                  "pm.test('count coincide', () => pm.expect(body.count).to.eql(body.data.length));",
                  "pm.test('cada item trae id, nombre, tipo e item_id', () => body.data.forEach((i) => { pm.expect(i).to.have.property('id'); pm.expect(i).to.have.property('nombre'); pm.expect(i).to.have.property('tipo'); pm.expect(i).to.have.property('item_id'); }));",
                  "pm.test('incluye lotes y plantas del seed', () => {",
                  "  const ids = body.data.map((i) => i.id);",
                  "  pm.expect(ids.some((id) => String(id).startsWith('PLANTA_'))).to.eql(true);",
                  "  pm.expect(ids.some((id) => String(id).startsWith('LOTE_'))).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/inventario?action=get_consolidated",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inventario"
              ],
              "query": [
                {
                  "key": "action",
                  "value": "get_consolidated"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
