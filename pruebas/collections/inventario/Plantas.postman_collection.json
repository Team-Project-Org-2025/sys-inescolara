                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const id = pm.collectionVariables.get('plantaId');",
                  "const plantas = pm.response.json().plantas;",
                  "",
                  "pm.test('La planta ya no aparece en el listado', () => {",
                  "  const item = plantas.find((p) => p.id === id);",
                  "  pm.expect(item, 'planta ' + id + ' sigue visible').to.be.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/plantas?action=get_plants",
