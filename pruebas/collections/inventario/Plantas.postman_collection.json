    {
      "name": "01 · Listado",
      "item": [
        {
          "name": "GET get_plants",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('success = true', () => {",
                  "  pm.expect(body.success).to.eql(true);",
                  "});",
                  "",
                  "pm.test('plantas es un arreglo', () => {",
                  "  pm.expect(body.plantas).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('count coincide con el arreglo', () => {",
                  "  pm.expect(body.count).to.eql(body.plantas.length);",
                  "});",
                  "",
                  "pm.test('cada planta trae id y nombre_comun', () => {",
                  "  body.plantas.forEach((p) => {",
                  "    pm.expect(p).to.have.property('id');",
                  "    pm.expect(p).to.have.property('nombre_comun');",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/plantas?action=get_plants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plantas"
              ],
              "query": [
                {
                  "key": "action",
                  "value": "get_plants"
                }
              ]
            },
            "description": "Listado de plantas activas."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 · Crear",
      "item": [
        {
          "name": "POST add_ajax",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('success = true', () => pm.expect(body.success).to.eql(true));",
                  "",
                  "pm.test('Devuelve el id creado', () => {",
                  "  pm.expect(body.plant).to.be.an('object');",
                  "  pm.expect(body.plant.id).to.be.a('number');",
                  "});",
                  "",
                  "if (body.success) {",
                  "  pm.collectionVariables.set('plantaId', String(body.plant.id));",
                  "  pm.collectionVariables.set('nombreOriginal', body.plant.nombre_comun);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "nombre_comun",
                  "value": "Rosa Postman",
                  "type": "text"
                },
                {
                  "key": "nombre_tecnico",
                  "value": "Rosa canina",
                  "type": "text"
                },
                {
                  "key": "especie_id",
                  "value": "1",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/plantas?action=add_ajax",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plantas"
              ],
              "query": [
                {
                  "key": "action",
                  "value": "add_ajax"
                }
              ]
            },
            "description": "Crea una planta. Guarda el id en {{plantaId}}."
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 · Editar",
      "item": [
        {
          "name": "POST edit_ajax",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('success = true', () => {",
                  "  pm.expect(body.success).to.eql(true);",
                  "});",
                  "",
                  "const baseUrl = pm.environment.get('baseUrl');",
                  "const id = pm.collectionVariables.get('plantaId');",
                  "const nombreEditado = 'Rosa Editada';",
                  "pm.collectionVariables.set('nombreEditado', nombreEditado);",
                  "",
                  "pm.sendRequest({",
                  "  url: baseUrl + '/plantas?action=get_plants',",
                  "  header: { 'X-Requested-With': 'XMLHttpRequest' }",
                  "}, (err, res) => {",
                  "  pm.test('El cambio persiste en el listado', () => {",
                  "    pm.expect(err).to.be.null;",
                  "    const item = res.json().plantas.find((p) => String(p.id) === String(id));",
                  "    pm.expect(item, 'planta ' + id).to.exist;",
                  "    pm.expect(item.nombre_comun).to.eql(nombreEditado);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "id",
                  "value": "{{plantaId}}",
                  "type": "text"
                },
                {
                  "key": "nombre_comun",
                  "value": "Rosa Editada",
                  "type": "text"
                },
                {
                  "key": "nombre_tecnico",
                  "value": "Rosa canina",
                  "type": "text"
                },
                {
                  "key": "especie_id",
                  "value": "1",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/plantas?action=edit_ajax",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plantas"
              ],
              "query": [
                {
                  "key": "action",
                  "value": "edit_ajax"
                }
              ]
            },
            "description": "Edita la planta creada y verifica el cambio con un GET."
          },
          "response": []
        }
      ]
