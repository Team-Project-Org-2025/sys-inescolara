  "item": [
    {
      "name": "00 · Auth (admin)",
      "item": [
        {
          "name": "401 · GET sin sesion",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.cookies.clear();",
                  "pm.request.headers.remove('Cookie');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 sin sesion', () => pm.response.to.have.status(401));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('success = false', () => pm.expect(body.success).to.eql(false));",
                  "",
                  "pm.test('Mensaje No autorizado', () => {",
                  "  pm.expect(body.message).to.match(/no autorizado/i);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/plantas?action=get_plants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plantas"
              ],
              "query": [
                {
                  "key": "action",
                  "value": "get_plants"
                }
              ]
            },
            "description": "Sin cookie de sesion el endpoint responde 401 JSON."
          },
          "response": []
        },
        {
          "name": "POST /login (admin)",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login responde 302 o dashboard', () => {",
                  "  pm.expect([200, 302], 'Status: ' + pm.response.code).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test('Sesion PHP establecida', () => {",
                  "  pm.expect(pm.cookies.get('PHPSESSID')).to.be.a('string');",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Sin mensaje de error en el HTML', () => {",
                  "    pm.expect(pm.response.text()).to.not.include('id=\"loginError\"');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
