@startuml
!theme plain
skinparam defaultFontName Consolas
skinparam backgroundColor #FFFFF0
skinparam classBackgroundColor #F5F5FF
skinparam classBorderColor #333366
skinparam arrowColor #333366
skinparam packageStyle rectangle

' ============================================================================
' CLASE BASE COMPARTIDA
' ============================================================================
package "Base del Sistema" {
  abstract class "BaseDeDatos" as DB {
    - {field} pdo: PDO
    + __construct(string conexion = 'default')
    # db(): PDO
    + beginTransaction(): void
    + commit(): void
    + rollback(): void
    - loadEnv(): void
  }
}

' ============================================================================
' DIAGRAMA 1: SEGURIDAD
' ============================================================================
package "Base de Datos de Seguridad" as Seguridad {
  class "Usuario" as Usuario {
    # validationRules: array
    + __construct()
    - bootstrapDefaults(): void
    - normalizarFilaUsuario(array user): array
    + obtenerUltimoId(): ?int
    + authenticate(identificador, password)
    + verifyPassword(int id, string password): bool
    + obtenerPorTrabajadorId(int idTrabajador): ?array
    + obtenerUsuarioPorEmail(string email): ?array
    + actualizarPassword(int userId, string newPassword): bool
    - actualizarHashPassword(int userId, string plainPassword): void
    + getAll()
    + usuarioExiste(?int id, ?string nombreUsuario): bool
    + getById(int id)
    + add(string nombreUsuario, string password, int rolId, ?string correo, ?string avatar, ?int idTrabajadorRef)
    + update(int id, string nombreUsuario, int rolId, ?string correo, ?string password, ?string avatar, ?int idTrabajadorRef)
    + delete(int id)
    + actualizarPerfil(int id, string nombreUsuario, ?string correo, ?string password, ?string avatar): bool
    + obtenerRoles(): array
    + obtenerTodosPermisos(): array
    + obtenerPermisosUsuario(int userId): array
    + establecerPermisosUsuario(int userId, array permisos): void
    + obtenerPermisosRol(int rolId, ?int userId): array
    + esPasswordFuerte(string password): bool
  }

  class "Rol" as Rol {
    # validationRules: array
    + __construct()
    + obtenerTodos(): array
    + obtenerPorId(int id): ?array
    + existe(int id): bool
    + existePorNombre(string name, ?int excludeId): bool
    + eliminar(int id): bool
    + obtenerUltimoId(): ?int
    + agregar(string nombreRol, ?string descripcion): bool
    + actualizar(int id, string nombreRol, ?string descripcion): bool
  }

  class "RegistroAuditoria" as AuditLog {
    + __construct()
    + registrar(int userId, string action, string table, ?int recordId, oldValue, newValue): bool
    + obtenerTodos(): array
    + {static} grabar(string action, string table, ?int recordId, oldValue, newValue): void
    + obtenerPorId(int id): ?array
  }

  class "RestablecerPassword" as PassReset {
    + __construct()
    - bootstrapTable(): void
    + createToken(int usuarioId, string correo): string
    + validateToken(string token): ?array
    + markAsUsed(string token): void
    + deleteExpiredTokens(): void
  }

  class "Notificacion" as Notif {
    + __construct()
    + getUnreadCount(int userId): int
    + getRecent(int userId, int limit): array
    + getAll(int userId, int page, int perPage): array
    + markAsRead(int notificationId, int userId): bool
    + markAllAsRead(int userId): bool
    + markAllWarningsAsRead(int userId): bool
    + markTaskAssignedAsRead(int userId, string nombreTarea): bool
    + create(int userId, string titulo, ?string mensaje, string tipo, ?string link): bool
    + existsByTitle(int userId, string titulo): bool
    + delete(int notificationId, int userId): bool
  }
}

