# ==================================
# CONFIGURACIÓN DE BASE DE DATOS
# ==================================
# Base de datos principal (datos de negocio)
DB_HOST=localhost
DB_NAME=sysinescolara
DB_USER=root
DB_PASSWORD=
DB_PORT=3306
# DB_SSL=true              # Activar para conexión segura (Aiven, producción)
# DB_CA_CERT=/path/ca.pem  # Ruta al certificado CA (opcional)

# ==================================
# CONFIGURACIÓN DE BASE DE DATOS (SEGURIDAD)
# ==================================
# Base de datos secundaria (autenticación, roles, auditoría)
DB_SEC_HOST=localhost
DB_SEC_NAME=SysInescolara-Seguridad
DB_SEC_USER=root
DB_SEC_PASSWORD=
DB_SEC_PORT=3306

# ==================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ==================================
APP_ENV=development
APP_DEBUG=true
APP_PORT=80
APP_NAME="Sys Inescolara"
APP_URL=http://localhost/sys-inescolara/

# ==================================
# GOOGLE reCAPTCHA v2
# ==================================
# Obtén tus llaves gratis en: https://www.google.com/recaptcha
# Selecciona "reCAPTCHA v2" -> "Casilla 'No soy un robot'"
# Usa "localhost" como dominio al registrar
RECAPTCHA_SITE_KEY=6LfCAPQsAAAAAKlgdHnkBf2utrrPZ5MjXK1chf4k
RECAPTCHA_SECRET_KEY=6LfCAPQsAAAAAGB0vyXcGeKT_a0BLApb3lRbyWPu

# ==================================
# CONFIGURACIÓN SMTP (Correo)
# ==================================
# Usa Mailtrap.io para desarrollo (gratuito): https://mailtrap.io
# En producción, usa los datos SMTP de tu proveedor de correo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contrasena-de-aplicacion
SMTP_FROM=noreply@inecolara.gob.ve
SMTP_FROM_NAME="SYSINECOLARA"
SMTP_ENCRYPTION=tls

# ==================================
# CONFIGURACIÓN DE PHPMYADMIN
# ==================================
PMA_PORT=3306
