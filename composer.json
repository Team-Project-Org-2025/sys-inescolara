{
    "name": "root/sysinescolara",
    "type": "project",
    "require": {
        "dompdf/dompdf": "^3.1",
        "phpmailer/phpmailer": "^7.1"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "SysInescolara\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SysInescolara\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "test:smoke": "phpunit --testsuite Smoke",
        "test:plantas": "phpunit --filter '/(PlantaTest|PlantaRepositoryTest|PlantaSmokeTest)::/'",
        "test:especies": "phpunit --filter '/(EspecieTest|EspecieRepositoryTest|EspecieSmokeTest)::/'"
    }
}
